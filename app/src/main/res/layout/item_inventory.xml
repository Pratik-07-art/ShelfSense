<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_white_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="15dp">

    <!-- Item name -->

    <TextView
        android:id="@+id/tvItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Milk"
        android:textColor="#292333"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Category -->

    <TextView
        android:id="@+id/tvCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Food/Grocery"
        android:textColor="#776F82"
        android:textSize="12sp" />

    <!-- Quantity -->

    <TextView
        android:id="@+id/tvQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Quantity: 2 Bottle"
        android:textColor="#494153"
        android:textSize="13sp" />

    <!-- Expiry -->

    <TextView
        android:id="@+id/tvExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Expires in 3 days • 28/09/2026"
        android:textColor="#FF9800"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>